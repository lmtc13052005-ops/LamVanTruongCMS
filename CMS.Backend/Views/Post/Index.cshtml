@model IEnumerable<CMS.Data.Entities.Post>

@{
    ViewData["Title"] = "Danh sách bài viết";
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="text-dark fw-bold m-0" style="font-family: Arial, sans-serif;">DANH SÁCH BÀI VIẾT</h2>
        <a href="/Post/Create" class="btn btn-success btn-sm fw-bold"><i class="bi bi-plus-circle"></i> Thêm bài viết mới</a>
    </div>

    <div class="row">
        @if (Model != null && Model.Any())
        {
            @foreach (var item in Model)
            {
                <div class="col-md-4 col-sm-6 mb-4">
                    <div class="card shadow-sm h-100 border-1">

                        <img src="@(string.IsNullOrEmpty(item.ImageUrl) ? "https://via.placeholder.com/350x200" : item.ImageUrl)" class="card-img-top" alt="Thumbnail" style="height: 180px; object-fit: cover;">

                        <div class="card-body d-flex flex-column p-3">
                            <span class="badge bg-info text-dark align-self-start mb-2 fw-semibold px-2 py-1" style="font-size: 11px;">
                                @(item.Category != null ? item.Category.Name : "Tin công nghệ")
                            </span>

                            <h5 class="card-title text-primary fw-bold mb-2 text-truncate" style="font-size: 16px;" title="@item.Title">
                                @item.Title
                            </h5>

                            <p class="card-text text-muted small mb-2 text-truncate flex-grow-1">
                                @item.Content
                            </p>

                            <p class="text-secondary mb-3" style="font-size: 12px;">
                                Ngày đăng: @item.CreatedDate.ToString("dd/MM/yyyy")
                            </p>

                            <div class="d-flex gap-1 mt-auto justify-content-start">
                                <a href="/Post/Details/@item.Id" class="btn btn-outline-primary btn-sm px-2 py-1" style="font-size: 11px; border-radius: 3px;">Xem chi tiết</a>
                                <a href="/Post/Edit/@item.Id" class="btn btn-outline-warning btn-sm px-2 py-1" style="font-size: 11px; border-radius: 3px; color: #ffc107;">Sửa</a>
                                <a href="/Post/Delete/@item.Id" class="btn btn-outline-danger btn-sm px-2 py-1" style="font-size: 11px; border-radius: 3px;">Xóa</a>
                            </div>
                        </div>

                    </div>
                </div>
            }
        }
        else
        {
            <div class="col-12 text-center py-5">
                <div class="alert alert-light border shadow-sm">Hiện tại chưa có bài viết nào trong hệ thống.</div>
            </div>
        }
    </div>
</div>