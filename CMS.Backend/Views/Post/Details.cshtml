@model CMS.Data.Entities.Post

<div class="container mt-5">

    <h1 class="text-primary">
        @Model.Title
    </h1>

    <p class="text-muted">
        @Model.CreatedDate.ToString("dd/MM/yyyy")
    </p>

    <img src="@Model.ImageUrl"
         class="img-fluid mb-4" />

    <p class="fs-5">
        @Model.Content
    </p>

    <a href="/Post"
       class="btn btn-secondary">

        Quay lại

    </a>

</div>