@model IEnumerable<CMS.Data.Entities.Product>

@{
    ViewData["Title"] = "Danh sách sản phẩm";
}

<div class="container mt-4">
    <h2 class="text-success mb-3"><i class="bi bi-box-seam"></i> Quản lý danh sách sản phẩm mẫu</h2>
    <table class="table table-bordered table-striped align-middle">
        <thead class="table-success">
            <tr class="text-center">
                <th>Mã SP</th>
                <th>Tên sản phẩm</th>
                <th>Mô tả</th>
                <th>Giá bán</th>
                <th>Số lượng tồn</th>
                <th>Mã loại (Category ID)</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td class="text-center fw-bold">@item.Id</td>
                    <td>@item.Name</td>
                    <td>@item.Description</td>
                    <td class="text-end fw-bold text-primary">@item.Price.ToString("N0") VNĐ</td>
                    <td class="text-center">@item.StockQuantity</td>
                    <td class="text-center"><span class="badge bg-secondary">@item.CategoryProductId</span></td>
                </tr>
            }
        </tbody>
    </table>
</div>